# Copy to a protected local `.env` for development only. Never commit real values.
# Generate strong, unique values using your organization's approved secret manager.
APP_ENV=development
LOG_LEVEL=INFO

# Controller settings (planned; do not put production secrets here)
CONTROLLER_HOST=0.0.0.0
CONTROLLER_PORT=8000
DATABASE_URL=sqlite:///./managed_platform_dev.db

# Production example shape only; replace credentials outside version control:
# DATABASE_URL=postgresql+psycopg://<user>:<password>@postgres:5432/managed_platform

# Configure TLS at a trusted reverse proxy in production; HTTPS/WSS required.
PUBLIC_BASE_URL=https://controller.example.invalid

# Secret references/placeholders only. Runtime implementation must fail closed if unset.
# APP_SECRET=<set-via-secret-manager>
# INITIAL_ADMIN_PASSWORD=<set-via-secret-manager>
